+                       (owner_account,0 if rules.account_scoped(qid)else uid,qid,old,kind,json.dumps(row)))
+            db.execute('DELETE FROM '+table+' WHERE owner=? AND quest=?',(owner,qid))
+
+def before_action(db,uid,expected,kind,guard,*,qid):
