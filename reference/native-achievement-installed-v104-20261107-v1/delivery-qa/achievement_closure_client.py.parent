"""The same complete requests run on private, selected, public and local servers."""
from achievement_notebook_client import scenario as notebooks
from achievement_spa_client import scenario as spa

async def scenario(values,snapshot,report):
    await notebooks(values,snapshot,report)
    report['ok']=False
    await spa(values,snapshot,report)
    report.update(connected_source_types=44,connected_definitions=262,remaining_source_types=16,
        unresolved_original_reward_groups=53,new_tables=0,new_indexes=0,
        retained_Noah_rooms_spa_rooms_level_ED_and_one_egg_fixtures=True,
        natural_acquisition=False,native_Game=False,natural_GUI=False,production_clock_patch=False)
